# Copie este arquivo para .env (já está no .gitignore, nunca vai pro GitHub)
# e preencha com as credenciais reais. NUNCA cole esses valores no chat.

# --- iCloud Mail (domínio customizado dominio.com) ---
# Host/porta padrão do iCloud, normalmente não precisa mudar:
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587

# E-mail de login do seu Apple ID (pode ser diferente de seu-email@dominio.com,
# dependendo de como o domínio customizado foi configurado no iCloud+)
SMTP_USER=

# "Senha de app" gerada em https://appleid.apple.com → Fazer login e segurança
# → Senhas específicas de app. NÃO é a senha normal da sua conta Apple.
SMTP_PASS=

# Como o remetente aparece pro destinatário:
EMAIL_FROM="Seu Nome <seu-email@dominio.com>"
