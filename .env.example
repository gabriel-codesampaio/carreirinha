# Copie este arquivo para .env (já está no .gitignore, nunca vai pro GitHub)
# e preencha com as credenciais reais. NUNCA cole esses valores no chat.

# --- SMTP do seu provedor de e-mail ---
# Alguns exemplos de host/porta (use o que vale pra sua conta):
#   iCloud Mail  -> smtp.mail.me.com : 587
#   Gmail        -> smtp.gmail.com : 587
#   Outlook/365  -> smtp.office365.com : 587
SMTP_HOST=
SMTP_PORT=587

# Login da sua conta de e-mail.
# iCloud: use o endereço PRINCIPAL do iCloud Mail (ex.: nome@icloud.com), não o alias nem o domínio próprio.
# A senha (SMTP_PASS) é uma "senha de app": account.apple.com > Entrar e Segurança > Senhas de app.
# Gmail/Outlook com 2FA também usam senha de app.
# Teste com: node .claude/skills/enviar-email/scripts/send-email.mjs --testar
SMTP_USER=

SMTP_PASS=

# Como o remetente aparece pro destinatário (no iCloud pode ser um alias ou o seu domínio próprio):
EMAIL_FROM="Seu Nome <seu-email@dominio.com>"

# Opcional: cópia oculta (CCO) de todo e-mail de candidatura, pra guardar uma cópia na sua caixa.
# Um ou mais endereços separados por vírgula.
EMAIL_BCC=

# --- GitHub (opcional) ---
# Usado pela skill github-importar-perfil. Sem token, a API pública permite 60 requisições/hora,
# o que costuma bastar. Se bater no limite, crie um token sem nenhuma permissão marcada
# (só leitura de dados públicos) em https://github.com/settings/tokens e cole aqui.
GITHUB_TOKEN=

# --- PDF do currículo (opcional) ---
# Só se o Chrome/Edge/Chromium estiver fora do caminho padrão. Ex. macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=
