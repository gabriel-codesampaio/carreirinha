# Copie este arquivo para .env (já está no .gitignore, nunca vai pro GitHub)
# e preencha com as credenciais reais. NUNCA cole esses valores no chat.

# --- SMTP do seu provedor de e-mail ---
# Alguns exemplos de host/porta (use o que vale pra sua conta):
#   iCloud Mail  -> smtp.mail.me.com : 587
#   Gmail        -> smtp.gmail.com : 587
#   Outlook/365  -> smtp.office365.com : 587
SMTP_HOST=
SMTP_PORT=587

# Login da sua conta de e-mail. Se o provedor usar 2FA (iCloud, Gmail, etc.),
# gere uma "senha de app"/"app password" nas configurações de segurança da conta
# em vez de usar a senha normal.
SMTP_USER=

SMTP_PASS=

# Como o remetente aparece pro destinatário:
EMAIL_FROM="Seu Nome <seu-email@dominio.com>"
